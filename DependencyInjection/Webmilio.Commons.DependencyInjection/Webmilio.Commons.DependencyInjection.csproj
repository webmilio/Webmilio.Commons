<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
	<LangVersion>latest</LangVersion>
	<Authors>Webmilio</Authors>
	<PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<Version>2.1.2</Version>
	<RepositoryUrl>https://github.com/webmilio/Webmilio.Commons</RepositoryUrl>
	<PackageReleaseNotes>See github repository, docs\CHANGELOG.md.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="docs\README.md" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="docs\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </EmbeddedResource>
  </ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Webmilio.Commons.Extensions\Webmilio.Commons.Extensions.csproj" />
    <ProjectReference Include="..\Webmilio.Commons.DependencyInjection.Abstractions\Webmilio.Commons.DependencyInjection.Abstractions.csproj" />
  </ItemGroup>

</Project>
